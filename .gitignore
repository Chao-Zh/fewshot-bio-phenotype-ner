# ============================================================
# 1. Python 缓存 / 构建产物
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# ============================================================
# 2. 虚拟环境 / 环境变量
# ============================================================
.env
.env.*
*.env
.venv/
venv/
env/

# ============================================================
# 3. 编辑器 / 操作系统
# ============================================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# 4. WorkBuddy 项目数据（工作日志 / 本地路径 / 合规分析）
# ============================================================
.workbuddy/

# ============================================================
# 5. 数据集 —— 一律忽略（含病例原文，受天池保密条款约束）
#    使用全局模式兜底：任何位置的标注数据都不进仓库
# ============================================================
*.jsonl
*.bio
*.conll
*.conllu
*.tsv
*.csv
data/
dataset/
datasets/
raw/
processed/
samples/

# ============================================================
# 6. 大文件（本体 / 压缩包 / 模型权重 / 中间产物）
# ============================================================
# HPO 等本体文件（公开但体积大，不必入仓）
*.obo
*.owl
# 压缩包
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
# 模型权重与序列化对象（体积大，且可能含训练数据信息）
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.h5
*.onnx
*.pkl
*.pickle
# 词表中间产物
vocab.json

# ============================================================
# 7. 运行产出（可由脚本重建，且含原文）
# ============================================================
output/
output_real/*.jsonl
output_real/*.json
output_full/*.jsonl
output_full/*.json

# ---- 例外：仅保留纯聚合统计，绝不含原文 / HPO ID / 患者信息 ----
!output_real/report.md
!output_real/statistics.json
!output_full/dataset_report.md

# ============================================================
# 8. 日志 / 本地私有配置（可能含本地路径等个人信息）
# ============================================================
*.log
*.local
